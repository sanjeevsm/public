# Server
SERVER_PORT=8080

# Kafka
KAFKA_BROKERS=localhost:9092

# PostgreSQL (host port 5433 when using Docker infra)
DB_URL=jdbc:postgresql://localhost:5433/istream
DB_USER=istream
DB_PASSWORD=istream

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — change this in production (minimum 32 characters)
JWT_SECRET=change-this-in-production-must-be-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000

# Data Sources
CRYPTO_ENABLED=true
CRYPTO_ASSETS=BTC-USD,ETH-USD,SOL-USD
STOCKS_ENABLED=true
STOCK_ASSETS=AAPL,TSLA,MSFT
WEATHER_ENABLED=false
WEATHER_CITIES=London,New York
OPENWEATHER_API_KEY=

# Pipeline
POLL_INTERVAL_MS=5000

# Spring profile (use 'prod' for structured JSON logging)
SPRING_PROFILES_ACTIVE=default
