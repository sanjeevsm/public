# GitLab CI/CD Dashboard - Environment Configuration
# Copy this file to .env and fill in your values

# GitLab instance URL (required — no default)
GITLAB_URL=https://your-gitlab-instance.example.com

# Personal Access Token with api + read_repository scopes
GITLAB_TOKEN=your_personal_access_token_here

# Comma-separated project IDs to monitor (leave empty for all membership projects)
GITLAB_PROJECT_IDS=

# Max number of projects to fetch when GITLAB_PROJECT_IDS is empty
GITLAB_PROJECT_LIMIT=20

# API server port
APP_PORT=8090

# Log level: debug | info | warning | error
LOG_LEVEL=info

# API response cache TTL in seconds
CACHE_TTL=60

# Prometheus port (default 9091 to avoid conflict with other projects using 9090)
PROMETHEUS_PORT=9091

# Prometheus metrics retention
PROMETHEUS_RETENTION=30d

# Grafana port (default 3001 to avoid conflict with other projects using 3000)
GRAFANA_PORT=3001

# Grafana root URL — must match GRAFANA_PORT above (used by grafana.ini via ${GRAFANA_PORT})
GF_SERVER_ROOT_URL=http://localhost:3001

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Paths to Prometheus and Grafana executables (required by start.ps1 / start.sh)
# Windows example:  C:\tools\prometheus-3.12.0\prometheus.exe
# macOS example:    /usr/local/bin/prometheus   (Homebrew: brew install prometheus)
# Linux example:    /usr/local/bin/prometheus
PROMETHEUS_EXE=
# Windows example:  C:\tools\grafana-13.0.2\bin\grafana.exe
# macOS example:    /opt/homebrew/bin/grafana   (Homebrew: brew install grafana)
# Linux example:    /usr/sbin/grafana-server
GRAFANA_EXE=
# Windows example:  C:\tools\grafana-13.0.2
# macOS example:    /opt/homebrew/opt/grafana   (Homebrew)
# Linux example:    /usr/share/grafana
GRAFANA_ROOT=
