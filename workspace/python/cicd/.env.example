# CI/CD Dashboard — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Provider credentials (GitLab, GitHub, Bitbucket, Gitea) are entered via the
# Settings panel in the browser and stored in localStorage — NOT here.

# API server port
APP_PORT=8090

# Log level: debug | info | warning | error
LOG_LEVEL=info

# API response cache TTL in seconds (per-user, per-provider)
CACHE_TTL=60

# Prometheus port (default 9000)
PROMETHEUS_PORT=9000

# Prometheus metrics retention
PROMETHEUS_RETENTION=30d

# Grafana port (default 9001)
GRAFANA_PORT=9001

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Paths to Prometheus and Grafana executables (required by start.ps1 / start.sh)
# Windows example:  C:\tools\prometheus-3.12.0\prometheus.exe
# macOS example:    /usr/local/bin/prometheus   (brew install prometheus)
# Linux example:    /usr/local/bin/prometheus
PROMETHEUS_EXE=

# Windows example:  C:\tools\grafana-13.0.2\bin\grafana.exe
# macOS example:    /opt/homebrew/bin/grafana   (brew install grafana)
# Linux example:    /usr/sbin/grafana-server
GRAFANA_EXE=

# Windows example:  C:\tools\grafana-13.0.2
# macOS example:    /opt/homebrew/opt/grafana
# Linux example:    /usr/share/grafana
GRAFANA_ROOT=
