# Copy to .env and fill in values before starting the server.
# API keys are NOT stored here — they live in each user's browser localStorage.

# Required: random secret for Flask session signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ILAB_SECRET=change-me-to-a-random-hex-string

# Optional overrides
HOST=0.0.0.0        # 0.0.0.0 = all interfaces (LAN-accessible); 127.0.0.1 = localhost only
PORT=8001
FLASK_DEBUG=0
