# ═══════════════════════════════════════════════════════════════════
# FULL STACK configuration — used with docker-compose.stack.yml only.
#
# Each app can also be run individually from its own directory using its
# own docker-compose.yml and .env.example — see each app's README.
#
# To run the full stack:
#   cp .env.example .env
#   # edit .env — at minimum set HOST_IP
#   docker compose -f docker-compose.stack.yml build
#   docker compose -f docker-compose.stack.yml up -d
# ═══════════════════════════════════════════════════════════════════

# ── HOST IP ─────────────────────────────────────────────────────────────────
# Your machine's LAN IP address. Other computers use this to reach the apps.
# Windows:  run `ipconfig` → look for IPv4 Address under your active adapter
# Linux:    run `hostname -I | awk '{print $1}'`
#
# IMPORTANT: After changing HOST_IP, rebuild the React frontends:
#   docker compose build itrack_frontend itransit_frontend
#   docker compose up -d itrack_frontend itransit_frontend
HOST_IP=192.168.1.x

# ── itrack ───────────────────────────────────────────────────────────────────
# SECRET_KEY must be at least 32 random characters (used for JWT signing)
ITRACK_SECRET_KEY=change-me-use-a-random-32-plus-char-string
ITRACK_MONGO_PASSWORD=change-me-mongo-password

# ── icare ────────────────────────────────────────────────────────────────────
ICARE_DB_PASSWORD=change-me-postgres-password
ICARE_API_SECRET=change-me-api-signing-secret
ICARE_WEB_SECRET=change-me-flask-session-secret

# ── ilab ─────────────────────────────────────────────────────────────────────
# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
ILAB_SECRET=change-me-random-hex-string

# ── itransit (optional) ──────────────────────────────────────────────────────
# Transport provider API keys — leave empty to use mock data instead.
# Copy itransit/.env.example → itransit/.env and fill in keys if you have them.
# The docker-compose.yml loads itransit/.env automatically (required: false).
