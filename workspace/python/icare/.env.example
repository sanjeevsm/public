# iCare - Environment Configuration
# Copy this file to .env and fill in your values

# ── API server (api/app.py) ────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic
DB_USER=postgres
DB_PASSWORD=your_password_here

# API server host and port
API_HOST=0.0.0.0
API_PORT=8004

# Secret used to sign auth tokens — CHANGE THIS in any real deployment.
# If left at the default, issued tokens can be forged.
API_SECRET=dev-secret

# Auth token lifetime in seconds (default 86400 = 24 hours)
API_TOKEN_EXP=86400

# ── Web frontend (web-app/client.py) ──────────────────────────────────────────

# URL of the API server (used by the web frontend)
API_URL=http://localhost:8004

# Web frontend host and port
WEB_HOST=0.0.0.0
WEB_PORT=3003

# Secret used to sign the Flask session cookie — CHANGE THIS in any real deployment.
WEB_SECRET=dev-secret

# White-label branding: name shown in the app badge/logo across all pages.
# Change this to your own product name when deploying for a different clinic/brand.
BRAND_NAME=iCare+
