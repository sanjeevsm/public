# PrimeCare - Environment Configuration
# Copy this file to .env and fill in your values

# ── API server (api/app.py) ────────────────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic
DB_USER=postgres
DB_PASSWORD=your_password_here

# API server port
API_PORT=5000

# ── Web frontend (web-app/client.py) ──────────────────────────────────────────

# URL of the API server (used by the web frontend)
API_URL=http://localhost:5000

# Web frontend port
WEB_PORT=5001
